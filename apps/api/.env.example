# Entorno de ejecución: local, staging o production.
APP_ENV=local
# Orígenes web separados por coma; usar URLs exactas en entornos no locales.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# No incluir claves privilegiadas de Supabase en este archivo.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar_en_servidor
